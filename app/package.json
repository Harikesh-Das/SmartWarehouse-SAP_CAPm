{
    "name": "com.smartwarehouse.smartwarehouseUI",
    "scripts": {
        "build": "mbt build --mtar com.smartwarehouse.smartwarehouseUI.mtar",
        "build:workspaces": "npm run build --workspaces --if-present",
        "deploy": "cf deploy mta_archives/com.smartwarehouse.smartwarehouseUI.mtar --retries 0",
        "lint": "npm run lint --workspaces --if-present",
        "ui5lint": "npm run ui5lint --workspaces --if-present",
        "start:smartwarehouse": "npm start --workspace smartwarehouse"
    },
    "dependencies": {
        "mbt": "^1"
    },
    "workspaces": [
        "smartwarehouse"
    ]
}
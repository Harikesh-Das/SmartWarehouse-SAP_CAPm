<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:uxap="sap.uxap"
	xmlns:template="http://schemas.sap.com/sapui5/extension/sap.ui.core.template/1"
	xmlns:fragments="sap.fe.templates.ObjectPage.view.fragments"
	xmlns:macros="sap.fe.macros"
	xmlns:macrosControls="sap.fe.macros.controls"
	xmlns:macrosHeader="sap.fe.macros.header"
	xmlns:fpm="sap.fe.macros.fpm"
	template:require="{
		UI: 'sap/fe/core/templating/UIFormatters',
		DATAFIELDHELPER : 'sap/fe/core/converters/helpers/DataFieldHelper',
		COMMONFORMATTERS: 'sap/fe/core/templating/CommonFormatters',
		OP: 'sap/fe/templates/ObjectPage/ObjectPageTemplating',
		FE_MODEL: 'sap/fe/core/helpers/ModelHelper'
	}"
>
	<template:with path="entityType>@com.sap.vocabularies.UI.v1.HeaderInfo" var="headerInfo">
		<template:with path="header>avatar" var="avatar">
			<uxap:expandedHeading>
				<template:with path="header>aiNotice/expandedHeadingId" var="aiNoticeId">
					<core:Fragment fragmentName="sap.fe.templates.ObjectPage.view.fragments.ExpandedHeading" type="XML" />
				</template:with>
			</uxap:expandedHeading>
			<uxap:snappedHeading>
				<FlexBox renderType="Bare">
					<macrosControls:Avatar
						src="{avatar>src}"
						initials="{avatar>initials}"
						fallbackIcon="{avatar>fallbackIcon}"
						displayShape="{avatar>displayShape}"
						displaySize="S"
						imageFitType="{avatar>imageFitType}"
						tooltip="{= COMMONFORMATTERS.getBindingWithText(${headerInfo>Title/Value@@UI.getDataModelObjectPath}) }"
						showLightBox="true"
						lightBoxTitle="{avatar>lightBoxTitle}"
						lightBoxSubtitle="{avatar>lightBoxSubtitle}"
					/>
					<VBox>
						<macrosHeader:HeaderTitleDescription>
							<macrosHeader:layoutData>
								<FlexItemData minWidth="0" />
							</macrosHeader:layoutData>
						</macrosHeader:HeaderTitleDescription>
						<template:if test="{= ${header>aiNotice} &amp;&amp; ${header>aiNotice/visible} !== false }">
							<macros:AINotice visible="{header>aiNotice/visible}" placementType="Bottom">
								<macros:popoverContent>
									<template:if test="{header>aiNotice/contentFragmentName}">
										<template:then>
											<fpm:CustomFragment
												id="fe::snappedHeaderNotice"
												fragmentName="{header>aiNotice/contentFragmentName}"
												contextPath="{fullContextPath>}"
											/>
										</template:then>
										<template:elseif test="{header>aiNotice/contentText}">
											<Text text="{header>aiNotice/contentText}" />
										</template:elseif>
									</template:if>
								</macros:popoverContent>
							</macros:AINotice>
						</template:if>
					</VBox>
				</FlexBox>
			</uxap:snappedHeading>
			<template:if test="{= !${header>hasContent} }">
				<uxap:heading>
					<!-- Falls back to the expanded heading; uses a distinct id since both slots coexist in the control tree. -->
					<template:with path="header>aiNotice/defaultHeadingId" var="aiNoticeId">
						<core:Fragment fragmentName="sap.fe.templates.ObjectPage.view.fragments.ExpandedHeading" type="XML" />
					</template:with>
				</uxap:heading>
			</template:if>
			<uxap:snappedContent>
				<template:if test="{= ${entitySet>@@FE_MODEL.isCollaborationDraftSupported} }">
					<template:then>
						<MessageStrip
							id="fe::ObjectPageDynamicHeaderTitle::SnappedCollaborationStrip"
							text="{sap.fe.i18n>C_COLLABORATIONDRAFT_USER_UNAUTHORIZED}"
							visible="{= ${ui>/showCollaborationStrip} === true}"
							showIcon="true"
							showCloseButton="true"
							type="Warning"
							class="sapUiSmallMargin"
							close=".handlers.closeCollaborationStrip"
						/>
					</template:then>
				</template:if>
				<MessageStrip
					visible="{= !${internal>OPCustomMessageStripVisible} &amp;&amp; (${internal>OPBackendMessageVisible} || ${internal>OPCustomMessageVisible} || false) }"
					text="{= ${internal>OPBackendMessageText} || ${internal>OPCustomMessageText}}"
					type="{= ${internal>OPBackendMessageType} || ${internal>OPCustomMessageType}}"
					showIcon="true"
					showCloseButton="true"
					class="sapUiSmallMarginTop"
					close=".handlers.closeOPMessageStrip"
				/>
				<template:if test="{converterContext>transportSelection}">
					<fragments:TransportSelection />
				</template:if>
			</uxap:snappedContent>
			<uxap:expandedContent>
				<template:if test="{= ${entitySet>@@FE_MODEL.isCollaborationDraftSupported} }">
					<template:then>
						<MessageStrip
							id="fe::ObjectPageDynamicHeaderTitle::ExpandedCollaborationStrip"
							text="{sap.fe.i18n>C_COLLABORATIONDRAFT_USER_UNAUTHORIZED}"
							visible="{= ${ui>/showCollaborationStrip} === true}"
							showIcon="true"
							showCloseButton="true"
							type="Warning"
							class="sapUiSmallMargin"
							close=".handlers.closeCollaborationStrip"
						/>
					</template:then>
				</template:if>
				<MessageStrip
					visible="{= !${internal>OPCustomMessageStripVisible} &amp;&amp; (${internal>OPBackendMessageVisible} || ${internal>OPCustomMessageVisible} || false) }"
					text="{= ${internal>OPBackendMessageText} || ${internal>OPCustomMessageText}}"
					type="{= ${internal>OPBackendMessageType} || ${internal>OPCustomMessageType}}"
					showIcon="true"
					showCloseButton="true"
					class="sapUiSmallMarginTop"
					close=".handlers.closeOPMessageStrip"
				/>
				<template:if test="{converterContext>/transportSelection}">
					<fragments:TransportSelection leadingControl="true" />
				</template:if>
			</uxap:expandedContent>
			<uxap:snappedTitleOnMobile>
				<template:with path="entityType>@com.sap.vocabularies.UI.v1.HeaderInfo" var="headerInfo">
					<template:if test="{entityType>@com.sap.vocabularies.UI.v1.HeaderInfo/Title}">
						<template:if test="{= !DATAFIELDHELPER.isHeaderStaticallyHidden(${headerInfo>Title@@UI.getDataModelObjectPath})}">
							<Title
								text="{= OP.getExpressionForTitle(${fullContextPath>@@UI.getDataModelObjectPath}, ${viewData>}, ${headerInfo>@@UI.getConverterContext})}"
								wrapping="true"
								level="H2"
							/>
						</template:if>
					</template:if>
				</template:with>
			</uxap:snappedTitleOnMobile>
		</template:with>
	</template:with>
</core:FragmentDefinition>

{
    "name": "smartwarehouse",
    "version": "0.0.1",
    "description": "smartwarehouse description",
    "keywords": [
        "ui5",
        "openui5",
        "sapui5"
    ],
    "main": "webapp/index.html",
    "devDependencies": {
        "@sap-ux/eslint-plugin-fiori-tools": "^10.0.0",
        "@sap-ux/ui5-middleware-fe-mockserver": "2",
        "@sap/ux-ui5-tooling": "1",
        "@ui5/cli": "^4.0.33",
        "@ui5/linter": "latest",
        "@wdio/cli": "^9.30.1",
        "@wdio/local-runner": "^9.30.1",
        "@wdio/mocha-framework": "^9.30.1",
        "@wdio/spec-reporter": "^9.30.1",
        "eslint": "^10",
        "wdio-ui5-service": "^3.0.11"
    },
    "scripts": {
        "start": "ui5 serve --config=ui5.yaml --open index.html",
        "build": "ui5 build self-contained --all --include-task generateVersionInfo --config=ui5.yaml --clean-dest --dest ../dist/smartwarehouse",
        "lint": "eslint ./",
        "start-mock": "fiori run --config ./ui5-mock.yaml --open \"/\"",
        "ui5lint": "ui5lint",
        "qunit": "fiori run --open test/unitTests.qunit.html",
        "opa5": "fiori run --open test/opaTests.qunit.html",
        "wdi5": "wdio run ./webapp/test/e2e/\\wdio.conf.js"
    },
    "sapux": true
}

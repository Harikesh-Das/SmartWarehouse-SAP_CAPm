<edmx:Edmx xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx" Version="4.0">
   

    <edmx:Reference Uri="https://sap.github.io/odata-vocabularies/vocabularies/UI.xml">
        <edmx:Include Namespace="com.sap.vocabularies.UI.v1" Alias="UI" />
    </edmx:Reference>

    <edmx:Reference Uri="/odata/v4/warehouse/$metadata">
        <edmx:Include Namespace="WarehouseService" />
    </edmx:Reference>

    <edmx:DataServices>
        <Schema xmlns="http://docs.oasis-open.org/odata/ns/edm" Namespace="local">
            <!-- SalesOrder List Report -->
            <Annotations Target="WarehouseService.SalesOrder">
                <Annotation Term="UI.LineItem">
                    <Collection>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="orderId" />
                            <PropertyValue Property="Label" String="Order ID" />
                        </Record>

                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="customerId" />
                            <PropertyValue Property="Label" String="Customer ID" />
                        </Record>

                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="status" />
                            <PropertyValue Property="Label" String="Status" />
                        </Record>
                    </Collection>
                </Annotation>
            </Annotations>

            <!-- Item Object Page -->
            <Annotations Target="WarehouseService.Item">
                <Annotation Term="UI.HeaderInfo">
                    <Record Type="UI.HeaderInfoType">
                        <PropertyValue Property="TypeName" String="Item" />

                        <PropertyValue Property="TypeNamePlural" String="Items" />

                        <PropertyValue Property="Title">
                            <Record Type="UI.DataField">
                                <PropertyValue Property="Value" Path="itemId" />
                            </Record>
                        </PropertyValue>
                    </Record>
                </Annotation>

                <Annotation Term="UI.Facets">
                    <Collection>
                        <Record Type="UI.ReferenceFacet">
                            <PropertyValue Property="Label" String="Item Information" />
                            <PropertyValue Property="Target" AnnotationPath="@UI.FieldGroup#ItemInformation" />
                        </Record>
                    </Collection>
                </Annotation>

                <Annotation Term="UI.FieldGroup" Qualifier="ItemInformation">
                    <Record Type="UI.FieldGroupType">
                        <PropertyValue Property="Data">
                            <Collection>
                                <Record Type="UI.DataField">
                                    <PropertyValue Property="Value" Path="itemId" />
                                    <PropertyValue Property="Label" String="Item ID" />
                                </Record>

                                <Record Type="UI.DataField">
                                    <PropertyValue Property="Value" Path="quantity" />
                                    <PropertyValue Property="Label" String="Quantity" />
                                </Record>
                            </Collection>
                        </PropertyValue>
                    </Record>
                </Annotation>
            </Annotations>
        </Schema>
    </edmx:DataServices>
</edmx:Edmx>

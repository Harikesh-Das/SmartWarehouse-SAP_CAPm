{
    "_version": "1.86.0",
    "sap.app": {
        "id": "smartwarehouse",
        "type": "application",
        "i18n": "i18n/i18n.properties",
        "applicationVersion": {
            "version": "0.0.1"
        },
        "title": "{{appTitle}}",
        "description": "{{appDescription}}",
        "resources": "resources.json",
        "sourceTemplate": {
            "id": "@sap/generator-fiori:lrop",
            "version": "1.18.6",
            "toolsId": "smartwarehouse"
        },
        "dataSources": {
            "mainService": {
                "uri": "/odata/v4/warehouse/",
                "type": "OData",
                "settings": {
                    "odataVersion": "4.0"
                }
            }
        }
    },
    "sap.ui": {
        "technology": "UI5",
        "icons": {
            "icon": "",
            "favIcon": "",
            "phone": "",
            "phone@2": "",
            "tablet": "",
            "tablet@2": ""
        },
        "deviceTypes": {
            "desktop": true,
            "tablet": true,
            "phone": true
        }
    },
    "sap.ui5": {
        "flexEnabled": false,
        "dependencies": {
            "minUI5Version": "1.148.3",
            "libs": {
                "sap.m": {},
                "sap.ui.core": {},
                "sap.fe.templates": {},
                "sap.fe.core": {}
            }
        },
        "contentDensities": {
            "compact": true,
            "cozy": true
        },
        "models": {
            "i18n": {
                "type": "sap.ui.model.resource.ResourceModel",
                "settings": {
                    "bundleName": "smartwarehouse.i18n.i18n"
                }
            },
            "": {
                "dataSource": "mainService",
                "preload": true,
                "settings": {
                    "operationMode": "Server",
                    "autoExpandSelect": true,
                    "earlyRequests": true
                }
            }
        },
        "routing": {
            "config": {
                "routerClass": "sap.f.routing.Router"
            },
            "routes": [
                {
                    "name": "SalesOrderListReport",
                    "pattern": ":?query:",
                    "target": "SalesOrderListReport"
                },
                {
                    "name": "SalesOrderObjectPage",
                    "pattern": "SalesOrder({SalesOrderKey}):?query:",
                    "target": "SalesOrderObjectPage"
                },
                {
                    "name": "ItemObjectPage",
                    "pattern": "SalesOrder({SalesOrderKey})/items({ItemKey}):?query:",
                    "target": "ItemObjectPage"
                },
                {
                    "name": "SollusanQuotasanObjectPage"
                    
                }
            ],
            "targets": {
                "SalesOrderListReport": {
                    "type": "Component",
                    "id": "SalesOrderListReport",
                    "name": "sap.fe.templates.ListReport",
                    "options": {
                        "settings": {
                            "contextPath": "/SalesOrder",
                            "hideFilterBar": false,
                            "initialLoad": "Enabled",
                            "navigation": {
                                "SalesOrder": {
                                    "detail": {
                                        "route": "SalesOrderObjectPage"
                                    }
                                }
                            },
                            "content": {
                                "header": {
                                    "actions": {
                                        "CreateSalesOrder": {
                                            "text": "Create Sales Order",
                                            "press": ".extension.smartwarehouse.ext.controller.SalesOrderListReport.onCreateSalesOrder",
                                            "requiresSelection": false
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "SalesOrderObjectPage": {
                    "type": "Component",
                    "id": "SalesOrderObjectPage",
                    "name": "sap.fe.templates.ObjectPage",
                    "options": {
                        "settings": {
                            "contextPath": "/SalesOrder",
                            "navigation": {
                                "items": {
                                    "detail": {
                                        "route": "ItemObjectPage"
                                    }
                                }
                            },
                            "content": {
                                "body": {
                                    "sections": {
                                        "WarehouseAllocation": {
                                            "template": "smartwarehouse.ext.fragment.WarehouseAllocation",
                                            "title": "Warehouse Allocation"
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "ItemObjectPage": {
                    "type": "Component",
                    "id": "ItemObjectPage",
                    "name": "sap.fe.templates.ObjectPage",
                    "options": {
                        "settings": {
                            "contextPath": "/Item",
                            "navigation": {}
                        }
                    }
                }
            }
        },
        "extends": {
            "extensions": {
                "sap.ui.controllerExtensions": {
                    "sap.fe.templates.ListReport.ListReportController": {
                        "controllerName": "smartwarehouse.ext.controller.SalesOrderListReport"
                    }
                }
            }
        }
    },
    "sap.fiori": {
        "registrationIds": [],
        "archeType": "transactional"
    }
}
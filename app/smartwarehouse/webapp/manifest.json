{
    "_version": "1.86.0",
    "sap.app": {
        "id": "smartwarehouse",
        "type": "application",
        "i18n": "i18n/i18n.properties",
        "applicationVersion": {
            "version": "0.0.1"
        },
        "title": "{{appTitle}}",
        "description": "{{appDescription}}",
        "resources": "resources.json",
        "sourceTemplate": {
            "id": "",
            "version": ""
        },
        "dataSources": {
            "annotation": {
                "type": "ODataAnnotation",
                "uri": "annotations/annotation.xml",
                "settings": {
                    "localUri": "annotations/annotation.xml"
                }
            },
            "mainService": {
                "uri": "/odata/v4/warehouse/",
                "type": "OData",
                "settings": {
                    "annotations": [
                        "annotation"
                    ],
                    "odataVersion": "4.0"
                }
            }
        }
    },
    "sap.ui": {
        "technology": "UI5",
        "icons": {
            "icon": "",
            "favIcon": "",
            "phone": "",
            "phone@2": "",
            "tablet": "",
            "tablet@2": ""
        },
        "deviceTypes": {
            "desktop": true,
            "tablet": true,
            "phone": true
        }
    },
    "sap.ui5": {
        "flexEnabled": true,
        "dependencies": {
            "minUI5Version": "1.148.3",
            "libs": {
                "sap.m": {},
                "sap.ui.core": {},
                "sap.fe.templates": {},
                "sap.fe.core": {}
            }
        },
        "contentDensities": {
            "compact": true,
            "cozy": true
        },
        "models": {
            "i18n": {
                "type": "sap.ui.model.resource.ResourceModel",
                "settings": {
                    "bundleName": "smartwarehouse.i18n.i18n"
                }
            },
            "": {
                "dataSource": "mainService",
                "preload": true,
                "settings": {
                    "operationMode": "Server",
                    "autoExpandSelect": true,
                    "earlyRequests": true
                }
            }
        },
        "resources": {
            "css": []
        },
        "routing": {
            "config": {},
            "routes": [
                {
                    "name": "SalesOrderListReport",
                    "pattern": ":?query:",
                    "target": "SalesOrderListReport"
                },
                {
                    "name": "SalesOrderObjectPage",
                    "pattern": "SalesOrder({SalesOrderKey}):?query:",
                    "target": "SalesOrderObjectPage"
                },
                {
                    "name": "ItemObjectPage",
                    "pattern": "SalesOrder({SalesOrderKey})/items({ItemKey}):?query:",
                    "target": "ItemObjectPage"
                }
            ],
            "targets": {
                "SalesOrderListReport": {
                    "type": "Component",
                    "id": "SalesOrderListReport",
                    "name": "sap.fe.templates.ListReport",
                    "options": {
                        "settings": {
                            "contextPath": "/SalesOrder",
                            "hideFilterBar": true,
                            "initialLoad": true,
                            "navigation": {
                                "SalesOrder": {
                                    "detail": {
                                        "route": "SalesOrderObjectPage"
                                    }
                                }
                            }
                        }
                    }
                },
                "ItemObjectPage": {
                    "type": "Component",
                    "id": "ItemObjectPage",
                    "name": "sap.fe.templates.ObjectPage",
                    "options": {
                        "settings": {
                            "navigation": {},
                            "contextPath": "/Item"
                        }
                    }
                },
                "SalesOrderObjectPage": {
                    "type": "Component",
                    "id": "SalesOrderObjectPage",
                    "name": "sap.fe.templates.ObjectPage",
                    "options": {
                        "settings": {
                            "contextPath": "/SalesOrder",
                            "navigation": {
                                "items": {
                                    "detail": {
                                        "route": "ItemObjectPage"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
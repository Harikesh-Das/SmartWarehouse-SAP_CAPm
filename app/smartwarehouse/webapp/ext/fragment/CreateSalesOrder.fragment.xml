<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m">

    <Dialog
        id="createSalesOrderDialog"
        title="Create Sales Order"
        contentWidth="500px"
        contentHeight="600px">

        <content>
            <VBox class="sapUiSmallMargin">

                <Label text="Order ID"/>
                <Input id="orderId"/>

                <Label text="Customer ID"/>
                <Input id="customerId"/>

                <Label text="Status"/>
                <Select id="status" selectedKey="open">
                    <items>
                        <core:Item key="open" text="Open"/>
                        <core:Item key="completed" text="Completed"/>
                        <core:Item key="cancelled" text="Cancelled"/>
                    </items>
                </Select>

                <Label text="Customer Latitude"/>
                <Input id="customerLatitude" type="Number"/>

                <Label text="Customer Longitude"/>
                <Input id="customerLongitude" type="Number"/>

                <Label text="Items" class="sapUiSmallMarginTop"/>

                <VBox id="itemsContainer"/>

                <Button
                    text="Add Item"
                    icon="sap-icon://add"
                    press=".onAddItem"/>

            </VBox>
        </content>

        <beginButton>
            <Button
                text="Save"
                type="Emphasized"
                press=".onSaveSalesOrder"/>
        </beginButton>

        <endButton>
            <Button
                text="Cancel"
                press=".onCancelSalesOrder"/>
        </endButton>

    </Dialog>

</core:FragmentDefinition>
<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
>
    <VBox
        id="smargin"
        class="sapUiSmallMargin"
        width="100%"
        core:require="{handler: 'smartwarehouse/ext/controller/warehouseAllocation.controller'}"
        modelContextChange="handler.onInit"
    >
        <HBox
            id="statistics"
            justifyContent="SpaceBetween"
            width="100%"
        >
            <VBox id="quantity">
                <Label
                    id="qLabel"
                    text="Total Quantity"
                />
                <Text
                    id="qText"
                    text="{allocation>/totalQuantity}"
                />
            </VBox>

            <VBox id="avgQuantity">
                <Label
                    id="avgQLabel"
                    text="Average Quantity"
                />
                <Text
                    id="avgQText"
                    text="{allocation>/averageQuantity}"
                />
            </VBox>

            <VBox id="itemCount">
                <Label
                    id="iCntLabel"
                    text="Item Count"
                />
                <Text
                    id="iCntText"
                    text="{allocation>/itemCount}"
                />
            </VBox>
        </HBox>

        <Button
            id="allocate"
            text="Allocate Warehouse"
            icon="sap-icon://retail-store"
            core:require="{handler: 'smartwarehouse/ext/controller/warehouseAllocation.controller'}"
            type="Emphasized"
            press="handler.allocateWarehouse"
            class="sapUiSmallMargin"
        />

        <VBox
            id="allocationResult"
            visible="false"
            class="sapUiSmallMargin"
        >
            <Label
                id="warehouseOutput"
                text="Best Warehouse"
            />
            <Text
                id="warehouseText"
                text="{allocation>/warehouseId}"
            />

            <Label
                id="availItemsOutput"
                text="Available Items"
            />
            <Text
                id="availItemsText"
                text="{allocation>/availableItems}"
            />

            <Label
                id="unavailItemsOutput"
                text="Unavailable Items"
            />
            <Text
                id="unavailItemsText"
                text="{allocation>/unavailableItems}"
            />
        </VBox>
    </VBox>
</core:FragmentDefinition>

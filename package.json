{
  "name": "SmartWarehouse",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@sap/cds": "^10.0.5"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3.0.2"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch"
  },
  "private": true,
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url":"db.sqlite"
        }
      }
    }
  },
  "osrm": {
    "kind": "rest",
    "credentials":{
      "url": "https://router.project-osrm.org"
    }
  }
}